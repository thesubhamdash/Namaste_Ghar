<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add a new Listing</title>
</head>
<body>
    <h3>Enter Details</h3>
    <form method="POST" action="/listings">
        <input type="text" placeholder="Enter title" name="listing[title]"> 
        <br><br>
        <textarea placeholder="Enter description" name="listing[desc]"></textarea>
        <br><br>
        <input type="text" placeholder="Enter image URL/Link" name="listing[image]"> 
        <br><br>
        <input type="number" placeholder="Enter price" name="listing[price]"> 
        <br><br>
        <input type="text" placeholder="Enter country name" name="listing[country]"> 
        <br><br>
        <input type="text" placeholder="Enter location" name="listing[location]"> 
        <br><br>
        <button>Submit</button>
    </form>
</body>
</html>